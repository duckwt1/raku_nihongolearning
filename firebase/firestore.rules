rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin accounts are created manually in Firebase Console.
    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // Shared dictionaries: Đã nạp xong toàn bộ N3, chuyển sang chế độ CHỈ ĐỌC để bảo vệ dữ liệu
    match /kanji/{char} {
      allow read: if true;
      allow write: if false;
    }

    match /words/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    match /sentences/{sentenceId} {
      allow read: if true;
      allow write: if false;
    }

    match /grammar/{grammarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // New grammar data by JLPT level (imported by admin via CSV)
    match /grammarPoints/{grammarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grammarLevels/{level} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grammarImports/{importId} {
      allow read, write: if isAdmin();
    }

    // Community Decks: mọi người được đọc, nhưng chỉ chủ sở hữu được sửa/xoá
    match /communityDecks/{deckId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.authorUid == request.auth.uid;
    }

    // Community Folders: app không còn ghi folder riêng, chỉ giữ dữ liệu cũ để đọc
    match /communityFolders/{folderId} {
      allow read: if true;
      allow write: if false;
    }

    // Grammar exercises: admin creates, everyone can practice
    match /grammarExercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User-specific data partition
    match /users/{uid} {
      // User profile / settings
      allow read, write: if isOwner(uid);

      // FSRS flashcards
      match /cards/{cardId} {
        allow read, write: if isOwner(uid);
      }

      // Review logs are immutable. Permit a same-value update so a retried
      // offline batch is idempotent if the prior commit reached Firestore but
      // the client did not receive its acknowledgement.
      match /reviewLogs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data == resource.data;
        allow delete: if false;
      }

      // Kanji mastery progress
      match /kanjiProgress/{char} {
        allow read, write: if isOwner(uid);
      }

      // Custom imported words
      match /customWords/{wordId} {
        allow read, write: if isOwner(uid);
      }

      // Import batch history
      match /imports/{importId} {
        allow read, write: if isOwner(uid);
      }

      // Folders and Decks
      match /folders/{folderId} {
        allow read, write: if isOwner(uid);
      }

      // Custom decks and questions
      match /decks/{deckId} {
        allow read, write: if isOwner(uid);

        match /questions/{qid} {
          allow read, write: if isOwner(uid);
        }
      }
    }
  }
}
