rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Shared dictionaries: Đã nạp xong toàn bộ N3, chuyển sang chế độ CHỈ ĐỌC để bảo vệ dữ liệu
    match /kanji/{char} {
      allow read: if true;
      allow write: if false;
    }

    match /words/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    match /sentences/{sentenceId} {
      allow read: if true;
      allow write: if false;
    }

    match /grammar/{grammarId} {
      allow read: if true;
      allow write: if false;
    }

    // Community Decks & Folders: Cho phép mọi người đọc để tự động hiển thị mặc định cho cả nhóm
    match /communityDecks/{deckId} {
      allow read: if true;
      allow write: if true;
    }

    match /communityFolders/{folderId} {
      allow read: if true;
      allow write: if true;
    }

    // User-specific data partition
    match /users/{uid} {
      // User profile / settings
      allow read, write: if isOwner(uid);

      // FSRS flashcards
      match /cards/{cardId} {
        allow read, write: if isOwner(uid);
      }

      // Review logs are immutable. Permit a same-value update so a retried
      // offline batch is idempotent if the prior commit reached Firestore but
      // the client did not receive its acknowledgement.
      match /reviewLogs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data == resource.data;
        allow delete: if false;
      }

      // Kanji mastery progress
      match /kanjiProgress/{char} {
        allow read, write: if isOwner(uid);
      }

      // Custom imported words
      match /customWords/{wordId} {
        allow read, write: if isOwner(uid);
      }

      // Import batch history
      match /imports/{importId} {
        allow read, write: if isOwner(uid);
      }

      // Folders and Decks
      match /folders/{folderId} {
        allow read, write: if isOwner(uid);
      }

      // Custom decks and questions
      match /decks/{deckId} {
        allow read, write: if isOwner(uid);

        match /questions/{qid} {
          allow read, write: if isOwner(uid);
        }
      }
    }
  }
}
