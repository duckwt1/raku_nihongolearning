# ==========================================
# CẤU HÌNH FIREBASE CHO WEB CLIENT (apps/web)
# ==========================================
# Lấy thông tin này tại: Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>) -> Config

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Tùy chọn: Đặt là "true" nếu bạn muốn dùng Firebase Emulator Suite chạy local (Auth 9099, Firestore 8080)
# Nếu muốn kết nối trực tiếp đến Firebase trên đám mây, hãy để "false" hoặc bỏ qua.
VITE_USE_EMULATOR=false
