# Firebase config (shared project with apps/web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=raku-nihongolearning.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=raku-nihongolearning
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=raku-nihongolearning.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=47955753075
EXPO_PUBLIC_FIREBASE_APP_ID=1:47955753075:web:bdbc212dc49d7238b3d206
EXPO_PUBLIC_USE_EMULATOR=false

# Google Sign-In (Firebase Console > Auth > Google; OAuth client IDs from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Cloudflare Worker API base URL (e.g. https://raku.example.com).
# In __DEV__, if omitted, mobile automatically derives http://<Expo-LAN-IP>:8787 for `npm run dev:worker`.
EXPO_PUBLIC_API_BASE_URL=
