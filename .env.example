# ==========================================
# CẤU HÌNH FIREBASE CHO WEB CLIENT (apps/web)
# ==========================================
# Lấy thông tin này tại: Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>) -> Config
# Sao chép file này thành .env trong thư mục apps/web/ (hoặc tại thư mục gốc)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Đặt là "true" nếu bạn muốn dùng Firebase Emulator Suite trên máy (Auth 9099, Firestore 8080)
# Mặc định để false để kết nối Firebase Cloud thật
VITE_USE_EMULATOR=false

# ==========================================
# CẤU HÌNH BACKEND WORKER & AI (worker)
# ==========================================
# Google Gemini API Key cho AI sinh câu hỏi & AI Import
GEMINI_API_KEY=your_gemini_api_key_here
